{% extends '_partials/layout.njk' %}
{% block content %}
{% if page.current == 1 and site.categories.length %}
<section class="home-categories" aria-labelledby="categories-title">
  <div class="section-heading"><h2 id="categories-title">{{ __('index.category') }}</h2><a href="{{ url_for(config.category_dir + '/') }}">{{ __('title.all') }} <span aria-hidden="true">↗</span></a></div>
  <div class="category-cards">{% for category in site.categories.sort('name').toArray() %}{% if not category.parent %}<a class="category-card" href="{{ url_for(syutoi_category_path(category)) }}"><span class="category-symbol" aria-hidden="true">#</span><strong>{{ category.name }}</strong><span>{{ category.posts.length }} {{ __('state.posts') }}</span></a>{% endif %}{% endfor %}</div>
</section>
{% endif %}
<section class="home-posts" aria-labelledby="posts-title">
  <div class="section-heading"><h2 id="posts-title">{{ __('desk.latest') }}</h2><a href="{{ url_for(config.archive_dir + '/') }}">{{ __('title.archive') }} <span aria-hidden="true">↗</span></a></div>
  {% include '_partials/post-list.njk' %}
  {% include '_partials/pagination.njk' %}
</section>
{% endblock %}
