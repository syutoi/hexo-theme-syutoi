{% extends '_partials/layout.njk' %}
{% block content %}
<header class="page-heading"><p class="eyebrow">{{ config.title }}</p><h1>{{ syutoi_title() }}</h1></header>
<div class="archive-list">
{% set current_year = '' %}
{% for post in page.posts.toArray() %}
  {% set year = date(post.date, 'YYYY') %}
  {% if year != current_year %}<h2 class="archive-year">{{ year }}</h2>{% set current_year = year %}{% endif %}
  <article class="archive-entry"><time datetime="{{ date(post.date, 'YYYY-MM-DD') }}">{{ date(post.date, 'MM-DD') }}</time><h3><a href="{{ url_for(post.path) }}">{{ post.title or __('post.untitled') }}</a></h3></article>
{% else %}<p>{{ __('desk.empty') }}</p>{% endfor %}
</div>
{% include '_partials/pagination.njk' %}
{% endblock %}
