<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id><%= config.url %></id>
  <title><%= config.title %></title>
  <icon><%= full_url_for('/images/favicon.png') %></icon>
  <%_ if (config.subtitle) { _%><subtitle><%= config.subtitle %></subtitle><%_ } _%>
  <link href="<%= config.url %>" />
  <link href="<%= full_url_for(config.feed.atom.output || 'atom.xml') %>" rel="self" type="application/atom+xml" />
  <author><name><%= config.author || config.title %></name></author>
  <updated><%= moment(posts.reduce((latest, post) => Math.max(latest, +(post.updated || post.date)), +lastBuildDate)).toISOString() %></updated>
  <%_ for (const post of posts) { _%>
  <entry>
    <id><%= post.permalink %></id>
    <title><%= post.title || post.slug %></title>
    <link rel="alternate" href="<%= post.permalink %>" />
    <%_ if (post.author) { _%><author><name><%= post.author %></name></author><%_ } _%>
    <content type="html"><%= post.content || '' %></content>
    <%_ for (const { name, path } of [...(post.categories ? post.categories.toArray() : []), ...(post.tags ? post.tags.toArray() : [])]) { _%>
    <category term="<%= name %>" scheme="<%= full_url_for(path) %>" />
    <%_ } _%>
    <published><%= moment(post.date).toISOString() %></published>
    <updated><%= moment(post.updated || post.date).toISOString() %></updated>
  </entry>
  <%_ } _%>
</feed>
