<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title><%= config.title %></title>
    <link><%= config.url %></link>
    <description><%= config.description || config.title %></description>
    <language><%= Array.isArray(config.language) ? config.language[0] : config.language %></language>
    <atom:link href="<%= full_url_for(config.feed.rss.output || 'rss.xml') %>" rel="self" type="application/rss+xml" />
    <lastBuildDate><%= moment(posts.reduce((latest, post) => Math.max(latest, +(post.updated || post.date)), +lastBuildDate)).locale('en').format('ddd, DD MMM YYYY HH:mm:ss ZZ') %></lastBuildDate>
    <%_ for (const post of posts) { _%>
    <item>
      <guid isPermalink="true"><%= post.permalink %></guid>
      <title><%= post.title || post.slug %></title>
      <link><%= post.permalink %></link>
      <%_ for (const { name } of [...(post.categories ? post.categories.toArray() : []), ...(post.tags ? post.tags.toArray() : [])]) { _%>
      <category><%= name %></category>
      <%_ } _%>
      <pubDate><%= moment(post.date).locale('en').format('ddd, DD MMM YYYY HH:mm:ss ZZ') %></pubDate>
      <description><%= post.content || '' %></description>
    </item>
    <%_ } _%>
  </channel>
</rss>
