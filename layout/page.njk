{% extends '_partials/layout.njk' %}
{% block content %}
<section class="article-page">
  <header class="page-heading"><p class="eyebrow">{{ config.title }}</p><h1>{{ syutoi_title() }}</h1></header>
  {% if page.type == 'categories' or page.type == 'tags' %}
  <ul class="taxonomy-list">
    {% set terms = site.categories if page.type == 'categories' else site.tags %}
    {% for term in terms.toArray() %}<li><a href="{{ url_for(term.path) }}">{{ term.name }}<span>{{ term.length }}</span></a></li>{% else %}<li>{{ __('desk.empty') }}</li>{% endfor %}
  </ul>
  {% elif page.type == '404' %}
    <p>{{ __('desk.not_found_description') }}</p><p><a href="{{ url_for('/') }}">{{ __('desk.back_home') }} →</a></p>
  {% else %}
    {% if syutoi_cover(page) %}<img class="article-cover" src="{{ syutoi_cover(page) }}" alt="" decoding="async">{% endif %}
    <div class="prose" data-prose data-copy-label="{{ __('desk.copy') }}" data-copied-label="{{ __('desk.copied') }}" data-copy-failed-label="{{ __('desk.copy_failed') }}">{{ page.content | safe }}</div>
  {% endif %}
</section>
{% endblock %}
