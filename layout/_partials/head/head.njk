<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f6f7f9">
{{ _js('syutoi.min.js') | safe }}
{% set page_title = syutoi_title() %}
<title>{{ page_title }}{% if page_title != config.title %} · {{ config.title }}{% endif %}</title>
<meta name="description" content="{{ syutoi_excerpt(page) if page.content else config.description }}">
<link rel="canonical" href="{{ full_url_for(page.path or '') }}">
<link rel="icon" href="{{ url_for('images/favicon.ico') }}">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ syutoi_excerpt(page) if page.content else config.description }}">
<meta property="og:type" content="{{ 'article' if is_post() else 'website' }}">
<meta property="og:url" content="{{ full_url_for(page.path or '') }}">
<meta property="og:site_name" content="{{ config.title }}">
{% if syutoi_feed('rss') %}<link rel="alternate" type="application/rss+xml" title="RSS" href="{{ syutoi_feed('rss') }}">{% endif %}
{% if syutoi_feed('atom') %}<link rel="alternate" type="application/atom+xml" title="Atom" href="{{ syutoi_feed('atom') }}">{% endif %}
{% if syutoi_feed('jsonFeed') %}<link rel="alternate" type="application/feed+json" title="JSON Feed" href="{{ syutoi_feed('jsonFeed') }}">{% endif %}
{{ _css('syutoi.min.css') | safe }}
