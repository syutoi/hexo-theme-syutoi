<div class="site-header">
  <div class="header-inner{% if not syutoi.navigation.menu.length %} without-navigation{% endif %}">
    <a class="site-brand" href="{{ url_for('/') }}" rel="home">{% if syutoi.branding.logo %}<img class="brand-mark brand-logo" src="{{ syutoi_url(syutoi.branding.logo, true) }}" alt="" width="29" height="29">{% else %}<span class="brand-mark" aria-hidden="true">S</span>{% endif %}{{ config.title }}</a>
    <div class="header-actions">
      {% if syutoi.search.provider != 'none' %}<a href="{{ url_for('search/') }}" aria-label="{{ __('search.title') }}"><svg width="44" height="44" viewBox="-10 -10 44 44" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></a>{% endif %}
      {% include '_partials/theme-toggle.njk' %}
      {% if syutoi.navigation.menu.length %}<button type="button" class="menu-toggle" data-nav-toggle hidden aria-controls="site-navigation" aria-expanded="false" aria-label="{{ __('desk.menu') }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>{% endif %}
    </div>
    {% if syutoi.navigation.menu.length %}<nav id="site-navigation" class="site-navigation" aria-label="{{ __('desk.navigation') }}">
      {% for item in syutoi_navigation() %}
        <a href="{{ syutoi_url(item.url) }}"{% if url_for(page.path or '') == syutoi_url(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>{% endif %}
  </div>
</div>
