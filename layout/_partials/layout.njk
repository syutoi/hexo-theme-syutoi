{% set syutoi = syutoi_settings() %}
{% set column = syutoi_column() %}
{% set comments = syutoi_comments() %}
{% set body = syutoi_body() if (is_post() or is_page()) and page.type not in ['categories', 'tags', '404'] else {} %}
{% set contents = toc(page.content, {list_number: syutoi.sidebar.toc_number}) if syutoi.sidebar.enable and syutoi.sidebar.toc and page.toc != false and (is_post() or (is_page() and page.content)) else '' %}
<!doctype html>
<html lang="{{ page.lang or config.language or 'en' }}" data-theme-default="{{ syutoi.appearance.theme }}">
<head>{% include '_partials/head/head.njk' %}</head>
<body class="{{ 'home-page' if is_home() else 'inner-page' }}">
  <a class="skip-link" href="#main">{{ __('desk.skip') }}</a>
  <header class="site-masthead">
    {% include '_partials/header.njk' %}
    {% include '_partials/hero.njk' %}
  </header>
  <div class="site-layout{% if not syutoi.sidebar.enable %} without-sidebar{% endif %}">
    <main id="main" class="site-main" tabindex="-1">{% block content %}{% endblock %}</main>
    {% if syutoi.sidebar.enable %}{% include '_partials/sidebar.njk' %}{% endif %}
  </div>
  {% include '_partials/footer.njk' %}
  {% if body.enabled %}{{ syutoi_lightbox_assets() | safe }}{% endif %}
  {% if page.type == 'search' and syutoi.search.provider != 'none' %}{{ syutoi_search_assets() | safe }}{% endif %}
  {% if comments %}{{ syutoi_comments_assets() | safe }}{% endif %}
</body>
</html>
