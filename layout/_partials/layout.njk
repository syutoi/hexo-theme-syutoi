<!doctype html>
<html lang="{{ page.lang or config.language or 'en' }}" data-theme-default="{{ theme.appearance.theme if theme.appearance and theme.appearance.theme else ('dark' if theme.darkmode else 'auto') }}">
<head>{% include '_partials/head/head.njk' %}</head>
<body class="{{ 'home-page' if is_home() else 'inner-page' }}">
  <a class="skip-link" href="#main">{{ __('desk.skip') }}</a>
  <div class="site-masthead">
    {% include '_partials/header.njk' %}
    {% include '_partials/hero.njk' %}
  </div>
  <div class="site-layout">
    <main id="main" class="site-main" tabindex="-1">{% block content %}{% endblock %}</main>
    {% include '_partials/sidebar.njk' %}
  </div>
  {% include '_partials/footer.njk' %}
</body>
</html>
