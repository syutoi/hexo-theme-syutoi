<aside class="site-sidebar{% if contents %} has-toc{% endif %}" aria-label="{{ __('sidebar.overview') }}">
  <section class="author-panel">
    {% if syutoi.branding.avatar %}<img class="author-avatar" src="{{ syutoi_url(syutoi.branding.avatar, true) }}" alt="" width="96" height="96" loading="lazy">{% else %}<span class="author-monogram" aria-hidden="true">{{ config.title | first }}</span>{% endif %}
    <h2>{{ config.author or config.title }}</h2>
    <p class="author-description">{{ config.description }}</p>
    {% if syutoi.sidebar.statistics %}<nav class="site-statistics" aria-label="{{ __('sidebar.overview') }}">
      <a href="{{ url_for(config.archive_dir + '/') }}"><strong>{{ site.posts.length }}</strong><span>{{ __('state.posts') }}</span></a>
      <a href="{{ url_for(config.category_dir + '/') }}"><strong>{{ site.categories.length }}</strong><span>{{ __('state.categories') }}</span></a>
      <a href="{{ url_for(config.tag_dir + '/') }}"><strong>{{ site.tags.length }}</strong><span>{{ __('state.tags') }}</span></a>
    </nav>{% endif %}
    {% if syutoi.social.length %}<nav class="social-links" aria-label="{{ __('desk.social') }}">{% for item in syutoi.social %}
      {% if item.icon %}
      <a class="social-icon" href="{{ syutoi_url(item.url) }}" aria-label="{{ item.name }}" title="{{ item.name }}">{% include '_partials/icons/' ~ item.icon ~ '.njk' %}</a>
      {% else %}<a href="{{ syutoi_url(item.url) }}">{{ item.name }} <span aria-hidden="true">↗</span></a>{% endif %}
    {% endfor %}</nav>{% endif %}
    {% if syutoi_feed('rss') %}<a class="subscribe-link" href="{{ syutoi_feed('rss') }}">{{ __('desk.rss') }} <span aria-hidden="true">↗</span></a>{% endif %}
  </section>
  {% if is_post() or (is_page() and page.content) %}
    {% if contents %}<nav class="sidebar-section article-toc" data-toc="desktop" aria-label="{{ __('sidebar.toc') }}"><h2>{{ __('sidebar.toc') }}</h2>{{ contents | safe }}</nav>{% endif %}
  {% elif syutoi.sidebar.categories %}
    <section class="sidebar-section"><h2>{{ __('title.category') }}</h2><ul class="sidebar-categories">{% for category in site.categories.sort('name').toArray() %}{% if not category.parent %}<li><a href="{{ url_for(category.path) }}"><span>{{ category.name }}</span><span>{{ category.length }}</span></a></li>{% endif %}{% endfor %}</ul></section>
  {% endif %}
</aside>
