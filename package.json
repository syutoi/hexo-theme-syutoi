{
  "name": "hexo-theme-syutoi",
  "version": "0.1.0",
  "description": "A calm and modern Hexo theme for writing, reading and thinking.",
  "author": "Ruri Shimotsuki",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.0.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare:example": "node toolbox/prepare-example.mjs",
    "dev": "node toolbox/dev.mjs",
    "build": "pnpm build:theme && pnpm build:example",
    "clean": "pnpm --dir example clean",
    "test": "pnpm test:unit && node toolbox/check-example.mjs && node toolbox/check-markdown.mjs && pnpm check:budget",
    "build:theme": "node toolbox/build.mjs",
    "build:example": "pnpm prepare:example && pnpm --dir example build",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "check:budget": "node toolbox/check-budget.mjs"
  },
  "dependencies": {
    "hexo-pagination": "^4.0.0",
    "hexo-util": "^3.3.0",
    "htmlparser2": "10.1.0",
    "js-yaml": "^4.1.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "autoprefixer": "10.4.23",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "photoswipe": "5.4.4",
    "postcss": "8.5.6",
    "postcss-import": "16.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
